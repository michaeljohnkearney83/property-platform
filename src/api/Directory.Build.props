<Project>
  <PropertyGroup>
    <!-- Product version: managed by release-please (single source: version.txt / .release-please-manifest.json). -->
    <Version>0.1.0</Version> <!-- x-release-please-version -->
    <Company>Property Platform</Company>
    <Product>Property Platform</Product>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <!-- Template/test noise we don't want to fail the build on -->
    <NoWarn>$(NoWarn);CA1062;CA1515;CA1707;CA1848;CA2007;CA1716;CA1031</NoWarn>
  </PropertyGroup>
</Project>
